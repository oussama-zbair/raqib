# ============================================================
# Raqib (رقيب) — environment template
# Copy to .env (backend) / set as secrets (GitHub Actions, Supabase, Cloudflare).
# NEVER commit real values.
# ============================================================

# ---- Supabase (shared by backend, bot, web) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # backend + bot only (full access, server-side)
SUPABASE_ANON_KEY=                    # web dashboard (read-only via RLS)

# ---- Telegram Bot ----
TELEGRAM_BOT_TOKEN=                   # from @BotFather
TELEGRAM_WEBHOOK_SECRET=              # random string to validate incoming webhooks
OWNER_TELEGRAM_ID=                    # your numeric Telegram id (grants /admin). @userinfobot
LOGO_URL=                            # public logo PNG, e.g. https://YOUR-SITE.pages.dev/logo.png
SITE_URL=                            # (optional) site base; LOGO_URL derived from it if unset

# ---- Google Gemini (fallback extractor) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- CIN encryption ----
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CIN_ENCRYPTION_KEY=

# ---- Scraping ----
HTTP_USER_AGENT=Raqib/0.1 (+https://github.com/oussama-zbair/raqib)
REQUEST_TIMEOUT_SECONDS=30

# ---- Telegram community ingestion (Telethon / MTProto) — optional, later phase ----
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION=
